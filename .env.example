# george-api — variáveis de ambiente (copie para .env; nunca commite segredos)

# --- Banco (obrigatório em produção; Postgres) ---
GEORGE_DB_URL=postgres://george:TROQUE@postgres:5432/george?sslmode=disable

# --- Segurança (obrigatório) ---
# openssl rand -base64 48
GEORGE_JWT_SECRET=
# opcional: chave separada para cifrar segredos em repouso (SSO, TOTP, senha de convite); se vazio, deriva do JWT secret
GEORGE_ENC_KEY=
GEORGE_ACCESS_TTL=15m
GEORGE_REFRESH_TTL=720h
GEORGE_INVITE_TTL=1h
# origens permitidas no CORS (lista separada por vírgula)
GEORGE_CORS_ORIGINS=https://georgedesk.com
# e-mails que viram super-admin (ops) ao logar
GEORGE_OPS_EMAILS=

# --- RustDesk (servidores que o cliente usa; chave pública do hbbs) ---
GEORGE_RUSTDESK_KEY=
GEORGE_ID_SERVER=georgedesk.com:21116
GEORGE_RELAY_SERVER=georgedesk.com:21117
GEORGE_PUBLIC_URL=https://georgedesk.com

# --- Billing (preparado; sem chave o portal responde 501) ---
GEORGE_STRIPE_SECRET_KEY=
GEORGE_STRIPE_WEBHOOK_SECRET=

# --- IA (F4; sem chave usa resumo/busca determinísticos) ---
GEORGE_AI_KEY=
GEORGE_AI_MODEL=claude-opus-5-5

# --- Operação ---
GEORGE_LOG_FORMAT=json
GEORGE_AUTO_MIGRATE=true
GEORGE_WORKERS=true
# se definido, /metrics exige "Authorization: Bearer <token>"
GEORGE_METRICS_TOKEN=
GEORGE_RELEASES_REPO=Nucleo-EBPOS/george-client

# --- Upstream (rustdesk-api) — continuam valendo ---
TZ=America/Sao_Paulo
RUSTDESK_API_LANG=en
RUSTDESK_API_GIN_API_ADDR=0.0.0.0:21114
RUSTDESK_API_APP_REGISTER=false
RUSTDESK_API_APP_WEB_CLIENT=0
